[Unit]
Description=Pickle web-terminal bridge (browser WS -> locked-down SSH to VM)
After=network.target
Wants=network.target

[Service]
User=pickle
Group=pickle
EnvironmentFile=/etc/pickle/sshgw.env
ExecStart=/opt/pickle/sshgw/bin/sshgw-terminal-bridge
WorkingDirectory=/opt/pickle/sshgw
Restart=on-failure
RestartSec=5
# Graceful deploy pair-swap: the bridge handles SIGTERM (main.go) by closing live
# sessions (1001 + BRIDGE_SHUTDOWN audit) and draining the HTTP listeners.
KillSignal=SIGTERM
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
# Sandboxing. The bridge terminates browser WebSockets and opens SSH sessions to
# user VMs: INET/INET6 plus AF_UNIX for logging, no children, no devices beyond
# the standard set, no kernel tunables. @system-service is the stock baseline.
# Neither daemon binds a privileged port, so it needs no capability at all.
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=~user
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
